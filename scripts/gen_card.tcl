module PdgCodeFilter BeamParticleFilter {
    set Invert true
    set RequireStatus true
    set Status -1
    set OutputArray BeamParticle
    add PdgCode {11}
    add PdgCode {-11}
}

module PdgCodeFilter TauFilter {
    set Invert true
    set RequireStatus false
    set OutputArray Tau
    add PdgCode {15}
    add PdgCode {-15}
}

module PdgCodeFilter ChargedPionFilter {
    set Invert true
    set RequireStatus true
    set OutputArray ChargedPion
    add PdgCode {211}
    add PdgCode {-211}
}

module PdgCodeFilter NeutralPionFilter {
    set Invert true
    set RequireStatus true
    set OutputArray NeutralPion
    add PdgCode {111}
}

module PdgCodeFilter NeutrinoFilter {
    set Invert true
    set RequireStatus true
    set OutputArray Neutrino
    add PdgCode {12}
    add PdgCode {-12}
    add PdgCode {14}
    add PdgCode {-14}
    add PdgCode {16}
    add PdgCode {-16}
}

